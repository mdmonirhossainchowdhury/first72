# Copy to .env and fill in. Everything works WITHOUT these (offline mode).

# --- Reasoning model: any OpenAI-compatible /chat/completions endpoint ---
# Option A: Meta Model API (Muse Spark). Take base URL + model id from Meta's docs.
# Option B: Muse Spark Open on Baseten / Modal / Fireworks (qualifies for the open-weights bonus prize).
#   The participant guide says to use model id: meta-models/muse-spark-open-1026
# Meta Model API (per dev.meta.ai docs): base https://api.meta.ai/v1, model muse-spark-1.3, key = your MODEL_API_KEY
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
META_REASONING_MODEL=muse-spark-1.3
# (Baseten open-weights instead: base = your Baseten URL, model = meta-models/muse-spark-open-1026, META_USE_SAM=0)

# No card for the Meta Model API? Use a Baseten/Modal endpoint above and set META_USE_SAM=0 (open-weights-only mode;
# the app uses classical segmentation and does not claim SAM).
META_USE_SAM=1

# --- SAM 3.1 via the Meta Model API (Responses API). Needs:  pip install meta-sam-parser ---
# If your reasoning model runs on Baseten/Modal/Fireworks, SAM still needs the *Meta Model API* base + key:
META_SAM_API_BASE=https://api.meta.ai/v1
META_SAM_API_KEY=   # leave empty to reuse META_API_KEY
META_SAM_MODEL=sam-3.1
META_SAM_MODE=concept      # concept = prompt "flooded land"; points = object prompts from change-detection seeds
# META_SAM_ENDPOINT=       # optional full URL override (default: {META_SAM_API_BASE}/responses)

# --- Analysis geometry ---
F72_PIXEL_METERS=10      # metres per pixel of your imagery (Sentinel-2 = 10)
F72_GRID=8               # zones per side (8 -> 64 zones, ids A1..H8)
F72_DEFAULT_DENSITY=1500 # people/km2 when no building footprints are available

# Hard cap on live model calls (counted in .api_calls, survives restarts). 0 = no cap.
# With a small limited key use 5; the 6th call is refused and the app falls back to offline mode.
F72_MAX_API_CALLS=5
